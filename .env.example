# Optional. Without these the app runs fully offline with a deterministic explanation
# (labelled as such in the UI). The assessment LEVEL is never produced by the model.
#
# Free-tier providers supported (plain fetch, no SDK):
#   AI_PROVIDER=groq        AI_MODEL=llama-3.3-70b-versatile          key: https://console.groq.com
#   AI_PROVIDER=gemini      AI_MODEL=gemini-2.0-flash                  key: https://aistudio.google.com
#   AI_PROVIDER=openrouter  AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
